# ─── App ────────────────────────────────────────────────────────────────
# Public base URL (used for metadata, emails and absolute links).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Contact address shown on the privacy policy and terms pages.
NEXT_PUBLIC_CONTACT_EMAIL=

# ─── Database (PostgreSQL / Neon) ───────────────────────────────────────
# Pooled connection string used by the app at runtime.
DATABASE_URL=
# Direct (non-pooled) connection string used by Prisma Migrate.
DIRECT_URL=

# ─── Authentication (manual, no third-party auth provider) ──────────────
# Random 32+ byte secret used to HMAC session tokens before storage.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# ─── AI ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# Optional overrides for OpenAI-compatible providers.
#
# Groq (free tier, implements both chat and /audio/transcriptions):
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_API_KEY=gsk_...
#   OPENAI_MODEL=openai/gpt-oss-120b    # strict JSON schema works only on Groq's
#                                       # gpt-oss models, and 20b truncates this
#                                       # report (~2k output tokens) — use 120b
#   OPENAI_TRANSCRIPTION_MODEL=whisper-large-v3
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
# "openai" in production. "mock" is for local development/tests only.
AI_PROVIDER=openai

# ─── Storage ────────────────────────────────────────────────────────────
# "local" (development only) writes to STORAGE_LOCAL_DIR and refuses to run on Vercel.
# "blob" uses a private Vercel Blob store (production). Connecting the store to the
# Vercel project adds BLOB_READ_WRITE_TOKEN automatically.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
BLOB_READ_WRITE_TOKEN=

# ─── Rate limiting ──────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Background jobs ────────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── Email ──────────────────────────────────────────────────────────────
# Without these, emails are logged instead of sent (development).
# Any SMTP server works via Nodemailer, e.g. Gmail (smtp.gmail.com, 587, an App
# Password), Zoho (smtp.zoho.com), Brevo (smtp-relay.brevo.com) or Amazon SES.
# Use port 587 (STARTTLS) or 465 (TLS); port 25 is blocked on Vercel.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreplygetconfident@gmail.com
SMTP_PASSWORD=nbxa ugho tmad gwbd
# Optional: "true" for TLS from the start. Defaults to true only on port 465.
SMTP_SECURE=false
# Sender shown to users, e.g. "Comm Coach <hello@yourdomain.com>".
EMAIL_FROM=GetConfident <noreply@getconfident.com>

# ─── Scheduled jobs ─────────────────────────────────────────────────────
# Shared secret for /api/cron/* (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# ─── Usage ──────────────────────────────────────────────────────────────
# Practice sessions each user can submit per 24 hours (each costs an AI
# transcription + analysis). Defaults to 15.
DAILY_SESSION_LIMIT=
